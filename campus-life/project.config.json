{
  "description": "校园生活小程序 — 本地化社交互动 + 本地生活工具",
  "projectname": "campus-life",
  "appid": "touristappid",
  "compileType": "miniprogram",
  "libVersion": "3.5.5",
  "setting": {
    "urlCheck": false,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "coverView": false,
    "nodeModules": false,
    "checkInvalidKey": true
  },
  "condition": {},
  "packOptions": {
    "ignore": [
      { "type": "folder", "value": "node_modules" },
      { "type": "folder", "value": "tests" },
      { "type": "folder", "value": "coverage" },
      { "type": "folder", "value": "docs" },
      { "type": "folder", "value": "tools" },
      { "type": "file", "value": "jest.config.js" },
      { "type": "file", "value": "jest.night.config.js" },
      { "type": "file", "value": "package.json" },
      { "type": "file", "value": "package-lock.json" },
      { "type": "file", "value": "README.md" }
    ]
  },
  "editorSetting": {
    "tabIndent": "insertSpaces",
    "tabSize": 2
  }
}
