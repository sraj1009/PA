.pg { padding: var(--s-3) var(--s-3) var(--s-6); }
.card { margin-bottom: var(--s-3); }
.bar { padding: var(--s-3) var(--s-4) var(--s-4); }

.tinput {
  height: 76rpx;
  padding: 0 var(--s-3);
  border-radius: var(--r-md);
  background: var(--canvas);
  border: 2rpx solid var(--line);
  font-size: var(--fs-body);
  margin-bottom: var(--s-3);
}

.chips { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-top: var(--s-2); }
.chip {
  padding: 10rpx 22rpx;
  border-radius: var(--r-pill);
  background: var(--canvas);
  border: 2rpx solid var(--line);
  color: var(--ink-2);
  font-size: var(--fs-sm);
}
.chip--on { background: var(--brand); border-color: var(--brand); color: #fff; }

.sumline { justify-content: space-between; margin-top: var(--s-3); }

.shop { padding: var(--s-3) var(--s-4); }
.s-name { font-size: var(--fs-body); font-weight: 600; }
.badge {
  margin-left: var(--s-2);
  padding: 2rpx 12rpx;
  border-radius: var(--r-pill);
  font-size: var(--fs-xs);
}
.badge--on { background: rgba(46, 211, 167, 0.16); color: #14876a; }
.badge--off { background: rgba(123, 137, 166, 0.16); color: var(--muted); }

.s-meta { display: flex; align-items: center; gap: var(--s-3); margin-top: var(--s-1); }
.rate { color: var(--brand-3); font-weight: 600; font-size: var(--fs-sm); }
.rate::before { content: '★ '; }
.price { color: var(--brand-2); font-size: var(--fs-sm); }
.dist { color: var(--muted); font-size: var(--fs-sm); }

.star { flex-shrink: 0; font-size: 40rpx; color: var(--muted); padding: var(--s-2) var(--s-1); }
.star--on { color: #f5b301; }

.empty { text-align: center; padding: var(--s-6) var(--s-4); }
.empty-t { font-size: var(--fs-lg); font-weight: 600; margin-bottom: var(--s-1); }
.js-reset { margin: var(--s-4) auto 0; }
