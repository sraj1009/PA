# ============================================================
#  BEE environment template
#  Copy to `.env` and fill in. `.env` is git-ignored — real
#  values must never be committed, logged, or printed.
#  NOTE: any credential that was previously stored in a
#  OneDrive-synced location (or shared anywhere) is COMPROMISED
#  — rotate it before use. See docs/SECURITY.md.
# ============================================================

# --- LiveKit Cloud (realtime voice) — REQUIRED for live voice ---
# Project: https://cloud.livekit.io  ->  your project -> API keys
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Cloud LLM providers ---
# Set the key that matches `cloud.llm` in config.yaml (provider-matched:
# a gemini/ model needs the Google key, an openai/ model needs OpenAI's, ...).
GOOGLE_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=

# --- Optional cloud overrides ---
# CLOUD_LLM=gemini/gemini-3.6-flash   # overrides cloud.llm
# CLOUD_BASE_URL=                      # custom endpoint

# --- Ollama (local models) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=bee4b
# OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Web UI ---
# Fixed bearer token for the web UI. Leave empty to auto-generate one per
# server start (printed once in the console and saved to temp/web_token.txt).
# BEE_WEB_TOKEN=

# --- Voice ---
# EDGE_TTS_KEY=                        # Azure key for higher-quality edge-tts
# BEE_USER_NAME=
