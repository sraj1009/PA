# ============================================================
#  BEE — version control ignore list
# ============================================================

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.hf/

# --- Secrets — NEVER commit (Phase 1 security) ---
.env
.env.*
!.env.example

# --- User data (memory, personalization) ---
memory/diary/
memory/lessons/
memory/vectors/
memory/profile.md
memory/longterm.md

# --- Generated / training data (can contain redacted-but-sensitive traces) ---
train/
metrics/
temp/
audit.jsonl

# --- Evals / jobs runtime artifacts ---
evals/results.jsonl
evals/dsa_bench.json
evals/verify_results.json
jobs.json
jobs.log
# Phase 6 durable job store (runtime state: jobs/executions/notifications)
automation/

# --- Model weights (large; live on this machine, not in VCS) ---
models/faster-whisper-base.en/
models/bee-qlora-*/
models/bee-merged-*/

# --- OS / logs ---
.DS_Store
*.log

# runtime state (Phase 12 repo hygiene, 2026-10-08)
memory/receipts.jsonl
memory/sessions/
memory/store.json
memory/checkpoints/
evals/results_summary.json
